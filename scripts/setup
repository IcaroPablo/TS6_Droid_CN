#!/bin/sh
# One-time setup for building on Chimera Linux: the pinned Rust toolchain in
# ~/.rustup and ~/.cargo, the pinned Android SDK packages in
# ~/.local/share/android-sdk and opus's models in ~/.local/share/telespeak.
# The host packages come first; see BUILDING.md. Running it again only
# installs what is missing; scripts/build runs it when the models are missing.
set -eu

ts_repo=$(cd "$(dirname "$0")/.." && pwd)
cd "$ts_repo"
. scripts/env.sh

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

if ! command -v rustup >/dev/null; then
	curl --proto '=https' --tlsv1.2 -fsSL -o "$tmp/rustup-init" \
		https://static.rust-lang.org/rustup/dist/x86_64-unknown-linux-musl/rustup-init
	chmod +x "$tmp/rustup-init"
	# No default toolchain and no PATH change in the shell profile: env.sh pins both
	"$tmp/rustup-init" -y --no-modify-path --profile minimal --default-toolchain none
fi
rustup toolchain install "$RUST_VERSION" --profile minimal --target aarch64-linux-android

# Each archive holds one top directory, which becomes the package's directory
echo "$SDK_PACKAGES" | while read -r dir archive sha256; do
	[ -d "$ANDROID_HOME/$dir" ] && continue
	curl --proto '=https' -fsSL -o "$tmp/$archive" "https://dl.google.com/android/repository/$archive"
	echo "$sha256  $tmp/$archive" | sha256sum -c -
	mkdir -p "$tmp/unpack" "$(dirname "$ANDROID_HOME/$dir")"
	unzip -q -d "$tmp/unpack" "$tmp/$archive"
	mv "$tmp/unpack"/* "$ANDROID_HOME/$dir"
	rm -rf "$tmp/unpack" "$tmp/$archive"
done

# opus's models: only the C sources and headers generated from them are kept
# (about 85 MB of the 135 MB archive)
if [ ! -f "$OPUS_MODEL_DIR/MODEL_SHA256" ]; then
	archive=opus_data-$OPUS_MODEL_SHA256.tar.gz
	curl --proto '=https' -fsSL -o "$tmp/$archive" "https://media.xiph.org/opus/models/$archive"
	echo "$OPUS_MODEL_SHA256  $tmp/$archive" | sha256sum -c -
	rm -rf "$OPUS_MODEL_DIR"
	mkdir -p "$OPUS_MODEL_DIR"
	tar -xzf "$tmp/$archive" -C "$OPUS_MODEL_DIR" $(tar -tzf "$tmp/$archive" | grep '^dnn/[^/]*\.[ch]$')
	echo "$OPUS_MODEL_SHA256" >"$OPUS_MODEL_DIR/MODEL_SHA256"
	rm "$tmp/$archive"
fi
