#!/bin/sh
# One-time setup for building on Chimera Linux: the pinned Rust toolchain in
# ~/.rustup and ~/.cargo, and the pinned Android SDK packages in
# ~/.local/share/android-sdk. The host packages come first; see BUILDING.md.
# Running it again only installs what is missing.
set -eu

ts_repo=$(cd "$(dirname "$0")/.." && pwd)
cd "$ts_repo"
. scripts/env.sh

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

if ! command -v rustup >/dev/null; then
	curl --proto '=https' --tlsv1.2 -fsSL -o "$tmp/rustup-init" \
		https://static.rust-lang.org/rustup/dist/x86_64-unknown-linux-musl/rustup-init
	chmod +x "$tmp/rustup-init"
	# No default toolchain and no PATH change in the shell profile: env.sh pins both
	"$tmp/rustup-init" -y --no-modify-path --profile minimal --default-toolchain none
fi
rustup toolchain install "$RUST_VERSION" --profile minimal --target aarch64-linux-android

if [ ! -x "$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager" ]; then
	curl --proto '=https' -fsSL -o "$tmp/cmdline-tools.zip" \
		"https://dl.google.com/android/repository/commandlinetools-linux-${CMDLINE_TOOLS_BUILD}_latest.zip"
	echo "$CMDLINE_TOOLS_SHA256  $tmp/cmdline-tools.zip" | sha256sum -c -
	unzip -q -d "$tmp" "$tmp/cmdline-tools.zip"
	mkdir -p "$ANDROID_HOME/cmdline-tools"
	mv "$tmp/cmdline-tools" "$ANDROID_HOME/cmdline-tools/latest"
fi
yes | sdkmanager --licenses >/dev/null
# shellcheck disable=SC2086 # one word per package
sdkmanager $SDK_PACKAGES
