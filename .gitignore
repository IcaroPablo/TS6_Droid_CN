# Gradle
.gradle/
build/
app/build/

# Kotlin compiler daemon logs
.kotlin/

# IDE
.idea/
*.iml
local.properties
gradle.properties

# Native libs (built from tslib).
# arm64-v8a is committed on purpose: CI runs `assembleDebug -x buildRustLibs` and packages
# whatever is checked in, so the core library has to live in git. Every other ABI is ignored.
app/src/main/jniLibs/*
!app/src/main/jniLibs/arm64-v8a/

# Signing
*.keystore
*.jks
# Local signing credentials (CI passes them as environment variables instead)
keystore.properties

# OS
.DS_Store
Thumbs.db

# TeamSpeak SDK (downloaded binary)
teamspeak-sdk-3.5.0/

# Built APKs (scripts/build)
/out/
