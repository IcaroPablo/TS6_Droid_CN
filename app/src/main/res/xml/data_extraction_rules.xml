<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup and transfer rules for Android 12+ (see android:dataExtractionRules).

  identity.enc holds the TeamSpeak private key,
  which must never leave the device:
  a restored or transferred copy would let anyone impersonating that identity
  authenticate as the user.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="identity.enc" />
        <!-- Bookmark store: holds server passwords -->
        <exclude domain="file" path="datastore/bookmarks.preferences" />
        <!-- Chat history -->
        <exclude domain="file" path="messages" />
        <exclude domain="file" path="attachments" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="identity.enc" />
        <exclude domain="file" path="datastore/bookmarks.preferences" />
        <exclude domain="file" path="messages" />
        <exclude domain="file" path="attachments" />
    </device-transfer>
</data-extraction-rules>
