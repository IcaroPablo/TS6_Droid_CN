<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup and transfer rules for Android 12+ (see android:dataExtractionRules).

  identity.ini holds the TeamSpeak private key, which must never leave the device:
  a restored or transferred copy would let anyone impersonating that identity
  authenticate as the user.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="identity.ini" />
        <!-- Bookmark store: server passwords live here in plaintext -->
        <exclude domain="file" path="datastore/bookmarks.preferences" />
        <!-- Chat history -->
        <exclude domain="file" path="messages" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="identity.ini" />
        <exclude domain="file" path="datastore/bookmarks.preferences" />
        <exclude domain="file" path="messages" />
    </device-transfer>
</data-extraction-rules>
